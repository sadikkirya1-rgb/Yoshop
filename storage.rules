rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid == 'Y0N3Ny1AX9VZEQb6AdRwhK8xpkg2' ||
        (request.auth.token.email != null && request.auth.token.email == 'sadikkirya@gmail.com')
      );
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isValidImageUpload() {
      return request.resource != null
        && request.resource.contentType.matches('image/(jpeg|png|gif|webp|jpg)')
        && request.resource.size <= 1048576
        && request.resource.size > 0;
    }

    // Allow authenticated users to upload to their own user folder
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null
        && (request.auth.uid == userId || isAdmin())
        && isValidImageUpload();
    }

    // Allow authenticated users to upload product/dish images to shops
    // This supports multi-tenant shops where each shop has its own folder
    match /shops/{shopId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isValidImageUpload();
    }

    // Default: deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
